# Presentify gateway: serves the screens and forwards API calls to the Supabase
# services inside the Docker network. This is the only published port.

limit_req_zone $binary_remote_addr zone=signin:10m rate=${SIGNIN_RATE_PER_MINUTE}r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=50r/s;
limit_req_zone $binary_remote_addr zone=functions:10m rate=20r/s;
# Participants: at a venue many phones may share one public address (one Wi-Fi network).
limit_req_zone $binary_remote_addr zone=participants:10m rate=${PUBLIC_RATE_PER_SECOND}r/s;
limit_req_zone $binary_remote_addr zone=participant_files:10m rate=${PUBLIC_RATE_PER_SECOND}r/s;
# The PDF viewer's background worker is a JavaScript module (.mjs); browsers refuse to
# run it unless it is served as JavaScript (adds to the standard list, does not replace it).
types { application/javascript mjs; }

limit_req_status 429;
limit_req_log_level warn;

# Behind an HTTPS reverse proxy (State Data Centre) keep its scheme.
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  ''      $scheme;
}

server {
  listen 8080;
  server_name _;
  server_tokens off;
  charset utf-8;

  # Services are resolved when used, so the gateway starts even if one is restarting.
  resolver 127.0.0.11 valid=10s ipv6=off;

  # Per-organisation file-size limits are enforced by Presentify; this is the outer ceiling.
  client_max_body_size 520m;

  proxy_http_version 1.1;
  proxy_set_header Host $http_host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $forwarded_proto;
  proxy_set_header X-Forwarded-Host $http_host;
  # Never let a browser impersonate a staff member towards server functions.
  proxy_set_header X-Presentify-Actor "";

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  # Rate-limited requests get a short JSON answer the screens can explain.
  error_page 429 = @rate_limited;
  location @rate_limited {
    default_type application/json;
    add_header Retry-After 60 always;
    return 429 '{"error":"rate_limited","msg":"Too many requests. Please wait a minute and try again."}';
  }

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 'ok';
  }

  # Runtime settings for the screens (public values only; never secrets).
  location = /config.js {
    default_type application/javascript;
    add_header Cache-Control "no-store" always;
    include /etc/nginx/snippets/security-headers.conf;
    return 200 'window.__PRESENTIFY__={anonKey:"${ANON_KEY}",publicUrl:"${PUBLIC_URL}",testMode:${TEST_MODE},emailEnabled:${EMAIL_ENABLED},sessionInactivity:"${SESSION_INACTIVITY_TIMEOUT}"};';
  }

  # ---- Auth ------------------------------------------------------------------
  # Administrative Auth endpoints are for server functions only.
  location ^~ /auth/v1/admin {
    return 403;
  }
  location = /auth/v1/token {
    limit_req zone=signin burst=30 nodelay;
    set $auth_upstream auth:9999;
    rewrite ^/auth/v1/(.*)$ /$1 break;
    proxy_pass http://$auth_upstream;
  }
  location /auth/v1/ {
    limit_req zone=api burst=100 nodelay;
    set $auth_upstream auth:9999;
    rewrite ^/auth/v1/(.*)$ /$1 break;
    proxy_pass http://$auth_upstream;
  }

  # ---- Database API ---------------------------------------------------------
  location /rest/v1/ {
    limit_req zone=api burst=200 nodelay;
    set $rest_upstream rest:3000;
    rewrite ^/rest/v1/(.*)$ /$1 break;
    proxy_pass http://$rest_upstream;
  }

  # ---- File storage ---------------------------------------------------------
  # Opening a file through a signed link (already authorised by its signature): when a hall opens the same
  # presentation together, all requests come from the venue's one Wi-Fi address — use the participant allowance.
  location /storage/v1/object/sign/ {
    limit_req zone=participant_files burst=3000 nodelay;
    set $storage_upstream storage:5000;
    rewrite ^/storage/v1/(.*)$ /$1 break;
    proxy_pass http://$storage_upstream;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    proxy_buffering off;
    proxy_read_timeout 600s;
  }

  location /storage/v1/ {
    limit_req zone=api burst=200 nodelay;
    set $storage_upstream storage:5000;
    rewrite ^/storage/v1/(.*)$ /$1 break;
    proxy_pass http://$storage_upstream;
    # Stored files are type-checked on upload; never let a browser guess another type.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;
  }

  # ---- Server functions -----------------------------------------------------
  location = /functions/v1/public {
    limit_req zone=participants burst=3000 nodelay;
    set $functions_upstream functions:9000;
    rewrite ^/functions/v1/(.*)$ /$1 break;
    proxy_pass http://$functions_upstream;
    proxy_read_timeout 60s;
  }
  location /functions/v1/ {
    limit_req zone=functions burst=50 nodelay;
    set $functions_upstream functions:9000;
    rewrite ^/functions/v1/(.*)$ /$1 break;
    proxy_pass http://$functions_upstream;
    proxy_read_timeout 160s;
  }

  # ---- Screens ----------------------------------------------------------------
  root /usr/share/nginx/html;

  # Participant pages (scan → register → view): a separate, small page.
  location /m/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files /m.html =404;
  }

  # PDF viewer resources (fonts, decoders) — versioned with the app build.
  location /pdfjs/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=86400" always;
    try_files $uri =404;
  }

  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri /index.html;
  }
}
