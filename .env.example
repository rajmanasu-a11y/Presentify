# Presentify configuration.
# Do not edit by hand the first time: run scripts/setup.ps1 (Windows) or
# scripts/setup.sh (Linux). They create .env with fresh random secrets.
# Never share .env or commit it to Git.

# Address that participants' phones and staff browsers use to reach Presentify.
# Laptop test mode:     http://<your-laptop-Wi-Fi-IP>:8080   (e.g. http://192.168.1.20:8080)
# State Data Centre:    https://presentify.<your-domain>
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080

# Shows "Test mode — not for official use" on every screen. Set false only on an HTTPS server.
TEST_MODE=true

# ---- Secrets (generated by the setup script) --------------------------------
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# ---- Sessions ----------------------------------------------------------------
# Access token lifetime in seconds (refreshed automatically while the screen is open).
JWT_EXPIRY=900
SESSION_INACTIVITY_TIMEOUT=30m
SESSION_MAX_LIFETIME=12h

# Sign-in attempts allowed per minute from one device / IP address (protects against password guessing).
SIGNIN_RATE_PER_MINUTE=30

# ---- Optional e-mail server (password-reset e-mails, e-mail OTP) ------------
# Leave SMTP_HOST empty until an e-mail server is available, then set EMAIL_ENABLED=true.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Presentify
